#!/usr/bin/env bash
set -Eeuo pipefail

TABLE_NAME="rw_node_guard"
RUNTIME_DIR=${RW_RUNTIME_DIR:-/run/rw-node-installer}
snapshot=${1:-}
metadata=${2:-}
install -d -m 0700 "$RUNTIME_DIR"
batch=$(mktemp "$RUNTIME_DIR/firewall-rollback.XXXXXX")
trap 'rm -f "$batch"' EXIT

case "$snapshot" in
    "$RUNTIME_DIR"/firewall-before.*.nft) ;;
    *) echo "Refusing unexpected snapshot path: $snapshot" >&2; exit 1 ;;
esac
if [[ -n $metadata && $metadata != "$RUNTIME_DIR/firewall-pending" ]]; then
    echo "Refusing unexpected metadata path: $metadata" >&2
    exit 1
fi

if nft list table inet "$TABLE_NAME" >/dev/null 2>&1; then
    printf 'delete table inet %s\n' "$TABLE_NAME" >"$batch"
fi
if [[ -n $snapshot && -s $snapshot ]]; then
    cat "$snapshot" >>"$batch"
fi

if [[ -s $batch ]]; then
    nft --check --file "$batch"
    nft --file "$batch"
fi

rm -f -- "$snapshot"
[[ -n $metadata ]] && rm -f -- "$metadata"
