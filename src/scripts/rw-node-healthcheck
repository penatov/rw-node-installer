#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG=/etc/rw-node-installer/config.env
# shellcheck disable=SC1090 # root-owned file generated by this project
[[ -r $CONFIG ]] && source "$CONFIG"
NODE_PORT=${NODE_PORT:-2222}

fail=0
check() {
    local label=$1
    shift
    if "$@" >/dev/null 2>&1; then
        printf 'OK   %s\n' "$label"
    else
        printf 'FAIL %s\n' "$label" >&2
        fail=1
    fi
}

check "docker daemon" systemctl is-active --quiet docker.service
check "remnanode container" sh -c "test \"\$(docker inspect --format '{{.State.Running}}' remnanode 2>/dev/null)\" = true"
check "node API listens on ${NODE_PORT}/tcp" sh -c "ss -H -ltn '( sport = :${NODE_PORT} )' | grep -q ."
check "nftables host table" nft list table inet rw_node_guard
check "Caddy service" systemctl is-active --quiet caddy.service
check "Caddy local TLS" curl -fsS --max-time 8 --resolve "${DOMAIN}:8443:127.0.0.1" "https://${DOMAIN}:8443/" -o /dev/null
check "Hysteria certificate" openssl x509 -in /etc/ssl/hysteria/fullchain.pem -noout -checkend 86400

exit "$fail"
