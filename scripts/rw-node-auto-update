#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG=/etc/rw-node-installer/config.env
PROJECT=/opt/remnanode
STATE=/var/lib/rw-node-installer
IMAGE=remnawave/node:latest
LOCK=/run/lock/rw-node-auto-update.lock

[[ -r $CONFIG ]] || { echo "Missing $CONFIG" >&2; exit 1; }
# shellcheck disable=SC1090 # root-owned file generated by this project
source "$CONFIG"
install -d -m 0755 "$(dirname "$LOCK")"
install -d -m 0700 "$STATE"
exec 9>"$LOCK"
flock -n 9 || { echo "Another update is running"; exit 0; }
cd "$PROJECT"

container_id=$(docker inspect --format '{{.Id}}' remnanode 2>/dev/null || true)
[[ -n $container_id ]] || { echo "remnanode is not installed" >&2; exit 1; }
old_image=$(docker inspect --format '{{.Image}}' remnanode)
docker image inspect "$old_image" >/dev/null
docker tag "$old_image" remnawave/node:rw-rollback

had_tcp443=false
had_udp443=false
ss -H -ltn '( sport = :443 )' | grep -q . && had_tcp443=true
ss -H -lun '( sport = :443 )' | grep -q . && had_udp443=true

echo "Pulling $IMAGE..."
docker pull "$IMAGE"
new_image=$(docker image inspect --format '{{.Id}}' "$IMAGE")

if [[ $new_image == "$old_image" ]]; then
    echo "Already up to date: $new_image"
    exit 0
fi

if [[ -s $STATE/rejected-image && $(<"$STATE/rejected-image") == "$new_image" ]]; then
    echo "Skipping previously rejected image $new_image"
    docker tag "$old_image" "$IMAGE"
    exit 0
fi

rollback() {
    local reason=$1
    echo "Update failed: $reason; rolling back to $old_image" >&2
    printf '%s\n' "$new_image" >"$STATE/rejected-image"
    docker tag remnawave/node:rw-rollback "$IMAGE"
    docker compose up -d --no-deps --force-recreate remnanode
    sleep 10
    /usr/local/lib/rw-node-installer/scripts/rw-node-healthcheck || true
    exit 1
}

docker compose up -d --no-deps --force-recreate remnanode || rollback "compose recreation"

healthy=false
for _ in $(seq 1 36); do
    running=$(docker inspect --format '{{.State.Running}}' remnanode 2>/dev/null || true)
    if [[ $running == true ]] && ss -H -ltn "( sport = :${NODE_PORT:-2222} )" | grep -q .; then
        if [[ $had_tcp443 == true ]] && ! ss -H -ltn '( sport = :443 )' | grep -q .; then
            sleep 5
            continue
        fi
        if [[ $had_udp443 == true ]] && ! ss -H -lun '( sport = :443 )' | grep -q .; then
            sleep 5
            continue
        fi
        healthy=true
        break
    fi
    sleep 5
done

[[ $healthy == true ]] || rollback "health timeout"
rm -f "$STATE/rejected-image"
printf '%s\t%s\tupdate\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$new_image" >>"$STATE/deployed-images.log"
chmod 0600 "$STATE/deployed-images.log"
docker image inspect --format 'Updated to {{.Id}} ({{.RepoTags}})' "$IMAGE"
